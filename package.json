{
  "name": "autoshorts-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "db:generate": "npm --workspace packages/db run prisma:generate",
    "db:migrate": "npm --workspace packages/db run prisma:migrate"
  },
  "dependencies": {
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  }
}
